    "format:check": "oxfmt --check --ignore-path ../../.oxfmtignore ."
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
