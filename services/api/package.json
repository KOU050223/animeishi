{
  "name": "@animeishi/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "test:watch": "vitest",
    "test:node": "vitest run --config vitest.node.config.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --ignore-path ../../.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path ../../.oxfmtignore .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply animeishi-db --local",
    "db:seed:local": "wrangler d1 execute animeishi-db --local --file=./seeds/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.12",
    "@clerk/hono": "^0.1.15",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@cloudflare/workers-types": "^4.20260416.2",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.12.0"
  }
}
