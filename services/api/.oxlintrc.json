{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-properties": [
      "error",
      {
        "object": "db",
        "property": "insert",
        "message": "DB writes outside repository/test setup should go through features/*/repository."
      },
      {
        "object": "db",
        "property": "update",
        "message": "DB writes outside repository/test setup should go through features/*/repository."
      },
      {
        "object": "db",
        "property": "delete",
        "message": "DB writes outside repository/test setup should go through features/*/repository."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "src/features/**/repository.ts",
        "src/test-utils/**/*.ts"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
