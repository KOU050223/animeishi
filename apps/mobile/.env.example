# Clerk
# https://dashboard.clerk.com → アプリ → API Keys → Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API
# ローカル開発: wrangler dev のデフォルトポート
# Expo Go 実機では localhost が端末自身を指すため、ネイティブ実行時は
# Expo の接続先ホスト（例: 192.168.x.x）へ自動変換される。
# 本番: https://animeishi-api.uomi.dev（GitHub Actions の Variables に登録）
# デプロイ時の環境変数の登録手順は docs/04_deployment.md を参照。
EXPO_PUBLIC_API_URL=http://localhost:8787

# 共有 URL（/share/...）のベース。Web Worker が /share/* を API へ転送するため
# ユーザー向け URL は Web ドメインで組み立てる（issue #408）。
# 通常は未設定でよい: Web 実行時は現在のオリジン、ネイティブ実行時は
# https://animeishi.uomi.dev にフォールバックする。
#
# ローカルで共有ページの動作を確かめたい場合: expo の開発サーバー
# （localhost:8081）は /share/* を API へ転送しないため、生成された
# リンクはそのままでは開けない。確認方法は 2 つ:
#   1. 生成 URL をローカル API に向ける（下記を有効化し、API 側は
#      `vp run @animeishi/api#dev` で起動）
#   2. 本番と同じ転送経路で確かめる（`build:web` のあと `wrangler dev` で
#      dist/ + 転送 Worker を配信。package.json の preview:web）
# EXPO_PUBLIC_WEB_URL=http://localhost:8787

# Annict OAuth
# https://annict.com/oauth/applications で取得した Client ID。
# 公開ビルドに埋め込まれてよい（client_secret は埋め込まず Workers 側のみ）。
EXPO_PUBLIC_ANNICT_CLIENT_ID=
# Web 版の redirect_uri。通常は未設定でよい（未設定時は <現在のオリジン>/annict）。
# PR プレビュー等の未登録オリジンから連携する場合に、Annict 登録済みの正規 URL
# （例: https://animeishi-web-production.uozumi05.workers.dev/annict）を指定すると、
# 正規オリジン側が code/state をこのオリジンへ中継する。CI のプレビューでは自動設定済み。
EXPO_PUBLIC_ANNICT_WEB_REDIRECT_URI=
# 通常は未設定でよい。ネイティブ実行時は Linking.createURL("annict") で自動生成する。
# Expo Go では exp://<MacのIP>:8081/--/annict が生成されるため、同じ値を Annict 側に登録する。
# どうしても手動固定したい場合だけ設定する。development build / standalone では animeishi://annict。
EXPO_PUBLIC_ANNICT_NATIVE_REDIRECT_URI=

# Sentry（任意）。設定するとローカル起動分も environment=development として送信される。
# 未設定なら SDK は no-op。動作確認したい場合のみ設定する。
# EXPO_PUBLIC_SENTRY_DSN=
# environment を production / preview に固定したい場合だけ設定する（通常は未設定でよい）。
# EXPO_PUBLIC_ENVIRONMENT=
