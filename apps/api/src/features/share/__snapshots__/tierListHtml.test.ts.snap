    .poster { width: 100%; aspect-ratio: 3 / 4; border-radius: 8px; overflow: hidden; background: var(--poster-fallback); }
    .poster img { width: 100%; height: 100%; object-fit: cover; }
    .card-title { display: -webkit-box; margin-top: 4px; font-size: 0.72rem; line-height: 1.3; color: var(--text-secondary);
      overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
    @media (max-width: 480px) {
      .tier-label { width: 56px; font-size: 1rem; }
      .tier-items { gap: 8px; padding: 8px; }
      .card { width: 68px; }
    }
  </style>
</head>
<body class="has-cta">
  <header class="hero">
    <div class="container">
      <p class="brand">ANIMEISHI</p>
      <p class="kind">Tier 表</p>
      <h1>歴代で好きなアニメ</h1>
      <p class="owner">tier-owner の Tier 表</p>
      <p class="description">年代をまたいで選んだ表</p>
      <ul class="stats"><li><strong>2</strong> 作品</li></ul>
    </div>
  </header>
  <main class="container">
  <div class="board">
    <div class="tier-row">
      <div class="tier-label" style="background-color: #ff7f7f; color: #1f2937">S</div>
      <div class="tier-items"><div class="card">
        <div class="poster"><img class="work-image" src="http://localhost/images/works/1001" data-fallback="[&quot;https://images.example.com/work-a-resolved.jpg&quot;,&quot;https://images.example.com/work-a-annict.jpg&quot;]" onerror="var a=[];try{a=JSON.parse(this.dataset.fallback||'[]')}catch(e){}var u=a.shift();if(u){this.dataset.fallback=JSON.stringify(a);this.src=u}else{this.remove()}" alt="" loading="lazy" /></div>
        <span class="card-title">作品A</span>
      </div></div>
    </div>
    <div class="tier-row">
      <div class="tier-label" style="background-color: #60a5fa; color: #1f2937">A</div>
      <div class="tier-items"><div class="card">
        <div class="poster"><img class="work-image" src="http://localhost/images/works/1002" onerror="this.remove()" alt="" loading="lazy" /></div>
        <span class="card-title">作品B</span>
      </div></div>
    </div>
  </div>
  </main>
  <footer class="site-footer container">
    <p><strong>Animeishi</strong> で共有されたページです</p>
  </footer>
  <div class="guest-cta"><a href="http://localhost/sign-up?from=share_custom_tier_list" data-source="share_custom_tier_list">あなたも Tier 表を作る</a></div>
</body>
</html>"
`;
