exports[`tier 表共有ページ HTML の固定 > キャラクター tier 表の共有ページ（OGP を含む）を固定する 1`] = `
"<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- ダーク閲覧時にスクロールバー等の UI クロームも追従させる -->
  <meta name="color-scheme" content="light dark" />
  <title>作品Aのキャラ Tier - Animeishi</title>
  <meta property="og:site_name" content="Animeishi" />
  <meta property="og:locale" content="ja_JP" />
  <meta name="description" content="tier-owner の作品A キャラクター Tier 表" />
  <meta property="og:title" content="作品Aのキャラ Tier - Animeishi" />
  <meta property="og:description" content="tier-owner の作品A キャラクター Tier 表" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="http://localhost/share/tier-lists/character-share-token" />
  <link rel="canonical" href="http://localhost/share/tier-lists/character-share-token" />
  <link rel="icon" href="http://localhost/favicon.ico" />
  <meta property="og:image" content="https://images.example.com/chara-a.png" />
  <meta name="twitter:image" content="https://images.example.com/chara-a.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="作品Aのキャラ Tier - Animeishi" />
  <meta name="twitter:description" content="tier-owner の作品A キャラクター Tier 表" />
  <style>
    :root {
      --bg: #f8fafc; --surface: #ffffff; --surface-muted: #f1f5f9;
      --border: #e2e8f0; --text: #0f172a; --text-secondary: #475569;
      --text-muted: #64748b; --primary: #4f46e5; --primary-text: #4f46e5;
      --primary-soft: #eef2ff; --primary-border: #a5b4fc;
      --poster-fallback: #e2e8f0;
      --shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 4px 16px rgba(15, 23, 42, 0.06);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #020617; --surface: #0f172a; --surface-muted: #1e293b;
        --border: #1e293b; --text: #f1f5f9; --text-secondary: #cbd5e1;
        --text-muted: #94a3b8; --primary: #4f46e5; --primary-text: #818cf8;
        --primary-soft: #312e81; --primary-border: #4338ca;
        --poster-fallback: #334155;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
      }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); line-height: 1.5;
      font-family: system-ui, -apple-system, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
      -webkit-font-smoothing: antialiased; }
    .container { width: 100%; max-width: var(--page-width, 760px); margin: 0 auto; padding: 0 16px; }
    .hero { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; padding: 20px 0 28px; }
    .brand { margin: 0 0 20px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; opacity: 0.9; }
    .kind { display: inline-block; margin: 0 0 8px; padding: 2px 10px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.18); font-size: 0.75rem; font-weight: 600; }
    h1 { margin: 0; font-size: 1.6rem; line-height: 1.3; overflow-wrap: anywhere; }
    .owner { margin: 6px 0 0; color: rgba(255, 255, 255, 0.85); font-size: 0.9rem; }
    .description { margin: 12px 0 0; color: rgba(255, 255, 255, 0.95); white-space: pre-wrap; overflow-wrap: anywhere; }
    .stats { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
    .stats li { padding: 4px 12px; border-radius: 10px; background: rgba(255, 255, 255, 0.14); font-size: 0.8rem; }
    .stats strong { font-size: 1rem; margin-right: 2px; }
    main.container { padding-top: 24px; padding-bottom: 8px; }
    .empty { padding: 32px 16px; text-align: center; color: var(--text-muted); background: var(--surface);
      border: 1px dashed var(--border); border-radius: 14px; }
    .work-image { display: block; object-fit: cover; background: var(--poster-fallback); }
    .site-footer.container { padding-top: 24px; padding-bottom: 40px; text-align: center; color: var(--text-muted); font-size: 0.8rem; }
    .site-footer strong { color: var(--primary-text); }
    /* 下部固定の登録 CTA（issue #217）。本文末尾を隠さないよう body に高さ分の余白を取る。 */
    body.has-cta { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }
    .guest-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: var(--surface); border-top: 1px solid var(--border); box-shadow: var(--shadow); }
    .guest-cta a { display: block; max-width: 480px; margin: 0 auto; padding: 14px 16px; border-radius: 12px;
      background: var(--primary); color: #ffffff; text-align: center; font-weight: 700; text-decoration: none; }
    :root { --page-width: 960px; }

    .board { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); }
    .tier-row { display: flex; align-items: stretch; border-bottom: 1px solid var(--border); }
    .tier-row:last-child { border-bottom: 0; }
    .tier-label { display: flex; align-items: center; justify-content: center; width: 76px; flex-shrink: 0; padding: 8px;
      font-weight: 800; font-size: 1.1rem; text-align: center; overflow-wrap: anywhere; }
    .tier-items { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 10px; padding: 10px; flex: 1; min-height: 88px; min-width: 0; }
    .card { width: 84px; }
    .poster { width: 100%; aspect-ratio: 3 / 4; border-radius: 8px; overflow: hidden; background: var(--poster-fallback); }
    .poster img { width: 100%; height: 100%; object-fit: cover; }
    .card-title { display: -webkit-box; margin-top: 4px; font-size: 0.72rem; line-height: 1.3; color: var(--text-secondary);
      overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
    @media (max-width: 480px) {
      .tier-label { width: 56px; font-size: 1rem; }
      .tier-items { gap: 8px; padding: 8px; }
      .card { width: 68px; }
    }
  </style>
</head>
<body class="has-cta">
  <header class="hero">
    <div class="container">
      <p class="brand">ANIMEISHI</p>
      <p class="kind">キャラクター Tier 表</p>
      <h1>作品Aのキャラ Tier</h1>
      <p class="owner">tier-owner の作品A キャラクター Tier 表</p>
      <p class="description">好きなキャラクターを並べた表</p>
      <ul class="stats"><li><strong>2</strong> キャラクター</li></ul>
    </div>
  </header>
  <main class="container">
  <div class="board">
    <div class="tier-row">
      <div class="tier-label" style="background-color: #ff7f7f; color: #1f2937">S</div>
      <div class="tier-items"><div class="card">
        <div class="poster"><img class="character-image" src="https://images.example.com/chara-a.png" alt="" loading="lazy" onerror="this.remove()" /></div>
        <span class="card-title">キャラA</span>
      </div></div>
    </div>
    <div class="tier-row">
      <div class="tier-label" style="background-color: #60a5fa; color: #1f2937">A</div>
      <div class="tier-items"><div class="card">
        <div class="poster"></div>
        <span class="card-title">キャラB</span>
      </div></div>
    </div>
  </div>
  </main>
  <footer class="site-footer container">
    <p><strong>Animeishi</strong> で共有されたページです</p>
  </footer>
  <div class="guest-cta"><a href="http://localhost/sign-up?from=share_character_tier_list" data-source="share_character_tier_list">あなたも Tier 表を作る</a></div>
</body>
</html>"
`;

