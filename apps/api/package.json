{
  "name": "@animeishi/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "test:watch": "vp test watch",
    "test:node": "vp test --project node",
    "lint": "vp lint . --deny-warnings",
    "lint:fix": "vp lint . --fix --deny-warnings",
    "fmt": "vp fmt --ignore-path ../../.oxfmtignore .",
    "fmt:check": "vp fmt --check --ignore-path ../../.oxfmtignore .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply animeishi-db --local",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@animeishi/danime-core": "workspace:*",
    "@animeishi/observability": "workspace:*",
    "@clerk/backend": "^3.2.12",
    "@clerk/hono": "^0.1.15",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/cloudflare": "11.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.18.0",
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript/native": "catalog:",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.1",
    "gql.tada": "1.11.5",
    "smol-toml": "1.9.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.167.0",
    "yaml": "^2.9.1"
  }
}
