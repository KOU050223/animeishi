{
  "name": "@animeishi/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "typecheck": "tsc --noEmit --checkers 1",
    "deploy": "wrangler deploy",
    "test:watch": "vitest",
    "test:node": "vitest run --config vitest.node.config.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "fmt": "vp fmt --ignore-path ../../.oxfmtignore .",
    "fmt:check": "vp fmt --check --ignore-path ../../.oxfmtignore .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply animeishi-db --local",
    "db:seed:local": "wrangler d1 execute animeishi-db --local --file=./seeds/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@animeishi/danime-core": "workspace:*",
    "@animeishi/observability": "workspace:*",
    "@clerk/backend": "^3.2.12",
    "@clerk/hono": "^0.1.15",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/cloudflare": "11.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^4.20260416.2",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript/native": "catalog:",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.1",
    "oxlint": "~1.72.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.12.0"
  }
}
